SOSOVALUE_API_KEY=your_sosovalue_key
GEMINI_API_KEY=your_gemini_key

# SoDEX network for readiness + Launch (testnet for public demos)
SODEX_NETWORK=testnet
# SODEX_NETWORK=mainnet
# Lock UI network switch on a deploy (optional)
# SODEX_NETWORK_LOCK=testnet

# Optional signed trading credentials (server-side operator fallback only)
# SODEX_API_KEY_NAME=your-api-key-name
# SODEX_API_PRIVATE_KEY=0x...
# SODEX_ACCOUNT_ID=12345

# Optional overrides
# SODEX_API_BASE_URL=https://testnet-gw.sodex.dev/api/v1/spot
# Default basket size when Launch loads (USD notional)
# SODEX_BASKET_NOTIONAL_USD=500

# Durable lifecycle + trade-journal store (recommended on Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
